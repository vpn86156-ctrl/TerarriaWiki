{
  "name": "zabroshka",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Пиксельный рогалик по заброшенным местам для Android",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:web": "vite build",
    "setup:android": "python3 scripts/setup-android.py",
    "setup:signing": "python3 scripts/setup-signing.py",
    "build:apk": "npm run build:web && python3 scripts/build-apk.py",
    "test": "node --test tests/*.test.js",
    "test:ui": "npm run build:web && playwright test",
    "test:apk": "python3 scripts/check-apk.py",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@fontsource/russo-one": "5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@postar/apktool-node": "0.3.4",
    "@sparticuz/chromium": "141.0.0",
    "aaptjs3": "2.0.2",
    "dataslope-tools-jar": "1.0.0",
    "vite": "7.3.7"
  }
}
