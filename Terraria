    <style>
        :root {
            --bg-dark: #090d16;
            --card-bg: rgba(17, 25, 43, 0.88);
            --slot-bg: #1e2b4d;
            --slot-border: #3d5285;
            --accent: #fbbf24;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: #f1f5f9;
            overflow-x: hidden;
        }

        .font-pixel {
            font-family: 'Press Start 2P', monospace;
            line-height: 1.5;
        }

        /* Crisp 1:1 Pixel Rendering for Authentic Terraria Sprites */
        .sprite {
            image-rendering: pixelated;
            image-rendering: crisp-edges;
            user-select: none;
        }

        .glass-card {
            background: linear-gradient(145deg, rgba(22, 32, 56, 0.92), rgba(13, 19, 36, 0.96));
            backdrop-filter: blur(16px);
            border: 1px solid rgba(99, 132, 204, 0.28);
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.75), inset 0 1px 0 0 rgba(255, 255, 255, 0.08);
            border-radius: 1.25rem;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .inv-slot {
            background: radial-gradient(circle at 30% 30%, rgba(46, 65, 114, 0.95), rgba(26, 37, 68, 0.98));
            border: 2px solid #455d94;
            box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.55), 0 4px 10px rgba(0, 0, 0, 0.35);
            border-radius: 0.85rem;
            transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
        }

        .inv-slot:hover {
            border-color: #fbbf24;
            transform: translateY(-3px) scale(1.03);
            box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.55), 0 8px 20px rgba(251, 191, 36, 0.28);
            z-index: 10;
        }

        .inv-slot-active {
            border-color: #fbbf24 !important;
            background: radial-gradient(circle at 30% 30%, rgba(79, 70, 125, 0.95), rgba(35, 45, 82, 0.98)) !important;
            box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.25), 0 8px 20px rgba(251, 191, 36, 0.3) !important;
        }

        .rarity-white { color: #ffffff; }
        .rarity-blue { color: #9696ff; }
        .rarity-green { color: #96ff96; }
        .rarity-orange { color: #ffc896; }
        .rarity-light-red { color: #ff9696; }
        .rarity-pink { color: #ff96ff; }
        .rarity-lime { color: #96ff0a; }
        .rarity-yellow { color: #ffff0a; }
        .rarity-cyan { color: #05c8ff; }
        .rarity-red { color: #ff2864; }
        .rarity-purple { color: #b428ff; }
        .rarity-rainbow {
            background: linear-gradient(90deg, #ff5e5e, #ffb84d, #ffff4d, #4dff4d, #4dd2ff, #b84dff, #ff5e5e);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: rainbowFlow 3s linear infinite;
        }

        @keyframes rainbowFlow {
            to { background-position: 200% center; }
        }

        @keyframes floatPedestal {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }

        @keyframes pulseGlow {
            0%, 100% { opacity: 0.35; transform: scale(1); }
            50% { opacity: 0.65; transform: scale(1.08); }
        }

        .animate-pedestal { animation: floatPedestal 3.2s ease-in-out infinite; }
        .animate-glow { animation: pulseGlow 4s ease-in-out infinite; }

        .fade-enter {
            animation: fadeInSlide 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes fadeInSlide {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #090d16; }
        ::-webkit-scrollbar-thumb { background: #2d3e66; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #4a66a3; }

        @media (max-width: 1023px) {
            body { padding-bottom: 5rem; }
        }
    </style>
</head>
